# TEMPLATE ONLY. Enter real values in Render's environment settings later.
# Do not copy this over backend/.env or backend/.env.test.
APP_ENV=production
DEPLOYMENT_ENVIRONMENT=staging
PYTHON_VERSION=3.12.10
FLASK_DEBUG=false
MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_CLUSTER.mongodb.net/iraseth_staging?retryWrites=true&w=majority
MONGO_DB_NAME=iraseth_staging
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=20000
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_64_HEX_SECRET
JWT_EXPIRES_HOURS=8
CORS_ORIGINS=https://REPLACE-DASHBOARD.vercel.app,https://REPLACE-STOREFRONT.vercel.app
SOCKET_AUTH_REQUIRED=true
TRUST_PROXY_COUNT=1
# First empty deployment only: false. After explicit staging initialization,
# set true and restart. Do not leave staff UAT running with legacy inventory.
BATCH_MODE=false
SEED_SUPERADMIN_EMAIL=REPLACE_WITH_GENUINE_STAGING_SUPERADMIN_EMAIL
SEED_SUPERADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STAGING_PASSWORD
SEED_SUPERADMIN_NAME=Staging Superadmin
SEED_ADMIN_EMAIL=REPLACE_WITH_GENUINE_STAGING_BOARD_ADMIN_EMAIL
SEED_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_STAGING_PASSWORD
SEED_ADMIN_NAME=Staging Board Admin
SEED_SUBADMIN_EMAIL=REPLACE_WITH_GENUINE_STAGING_OPERATOR_EMAIL
SEED_SUBADMIN_PASSWORD=REPLACE_WITH_ANOTHER_STAGING_PASSWORD
SEED_SUBADMIN_NAME=Staging Operator
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=REPLACE_WITH_PROVIDER_USERNAME
SMTP_PASSWORD=REPLACE_WITH_PROVIDER_SECRET
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER
SMTP_TIMEOUT_SECONDS=5
EMAIL_ASYNC=false
EMAIL_WORKERS=2
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PUBLIC_ORDERS_PER_MINUTE=30
RATE_LIMIT_INVENTORY_WRITES_PER_MINUTE=120
RATE_LIMIT_BACKUP_PER_MINUTE=5
MAX_ORDER_LINES=100
API_MAX_PAGE_SIZE=200
COMPRESS_MIN_SIZE=1024
BACKUP_DIR=/tmp/iraseth-staging-backups
BACKUP_RETENTION=3
