# Disposable local automated-test target only. Copy to .env.test if absent.
# conftest.py refuses any other database/endpoint; never use cloud credentials.
APP_ENV=testing
MONGO_DB_NAME=iraseth_test
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
JWT_SECRET=test-only-isolated-fixture-key-not-for-deployment
BATCH_MODE=false
FLASK_DEBUG=false
SOCKET_AUTH_REQUIRED=false
CORS_ORIGINS=http://127.0.0.1:5174
EMAIL_ASYNC=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
