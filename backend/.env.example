# Copy this file to .env and fill in real values. Never commit .env.

# --- MongoDB ---
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=iraseth_pharma

# --- Auth ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_HOURS=8

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# For local dev with the storefront opened via a static server:
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# --- Seed staff accounts (used only by seed.py) — change every password ---
SEED_SUPERADMIN_EMAIL=superadmin@irasethpharma.com
SEED_SUPERADMIN_PASSWORD=change-me-superadmin
SEED_SUPERADMIN_NAME=Super Admin

SEED_ADMIN_EMAIL=admin@irasethpharma.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ADMIN_NAME=Admin

SEED_SUBADMIN_EMAIL=subadmin@irasethpharma.com
SEED_SUBADMIN_PASSWORD=change-me-subadmin
SEED_SUBADMIN_NAME=Sub Admin

# --- Backups ---
BACKUP_DIR=backups
BACKUP_RETENTION=30

# --- Outbound email (optional) ---
# Leave SMTP_HOST blank to disable email sending — the API will still work,
# it will just log "email skipped" instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Iraseth Pharma <no-reply@irasethpharma.com>
SMTP_USE_TLS=true

# --- App ---
FLASK_PORT=5000
FLASK_DEBUG=false
