
# --- Environment ---
APP_ENV=development

# --- MongoDB ---
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=iraseth_pharma
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=20000

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_HOURS=8

# --- CORS / Socket.IO ---
# Comma-separated frontend origins. Production must not use *.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
# Keep false while testing the current frontend locally. Production should be true.
SOCKET_AUTH_REQUIRED=false

# --- Reverse proxy ---
# Local development: 0. Render commonly uses 1. Re-check if Cloudflare is added.
TRUST_PROXY_COUNT=0

# --- API rate limits ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PUBLIC_ORDERS_PER_MINUTE=30
RATE_LIMIT_INVENTORY_WRITES_PER_MINUTE=120
RATE_LIMIT_BACKUP_PER_MINUTE=5

# --- Seed staff accounts ---
SEED_SUPERADMIN_EMAIL=superadmin@irasethpharma.com
SEED_SUPERADMIN_PASSWORD=change-me-superadmin
SEED_SUPERADMIN_NAME=Super Admin

SEED_ADMIN_EMAIL=admin@irasethpharma.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ADMIN_NAME=Admin

SEED_SUBADMIN_EMAIL=subadmin@irasethpharma.com
SEED_SUBADMIN_PASSWORD=change-me-subadmin
SEED_SUBADMIN_NAME=Sub Admin

# --- Backups ---
BACKUP_DIR=backups
BACKUP_RETENTION=30

# --- Outbound email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Iraseth Pharma <no-reply@irasethpharma.com>
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=5
EMAIL_ASYNC=true
EMAIL_WORKERS=2

# --- Performance ---
MAX_ORDER_LINES=100
API_MAX_PAGE_SIZE=200
COMPRESS_MIN_SIZE=1024

# --- App ---
FLASK_PORT=5000
FLASK_DEBUG=false
