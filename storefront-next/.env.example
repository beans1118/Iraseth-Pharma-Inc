# Server-only Flask origin for catalog, inquiry submission and tracking.
CATALOG_API_BASE_URL=http://127.0.0.1:5000
# Public employee login/support application origin. Rebuild after changing it.
NEXT_PUBLIC_STAFF_LOGIN_URL=http://localhost:5173
# Legacy NEXT_PUBLIC_CATALOG_API_BASE remains supported; use the server-only
# setting above for new deployments. No JWT, MongoDB or SMTP secrets belong here.
